---
import { shown } from '../domain/facts';
import { property } from '../domain/property';
import { rentalFleet, rentalTerms } from '../domain/rental';
import { cleaningOffers, cleaningServices } from '../domain/services';
import { chapters } from '../experience/chapters';
import { copy } from '../experience/copy';
import map from '../experience/map-06.json';
import Base from '../layouts/Base.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import Chapter from '../ui/Chapter.astro';
import ExperienceTrack from '../ui/ExperienceTrack.astro';
import MobileBar from '../ui/MobileBar.astro';
import Rendezvous from '../ui/Rendezvous.astro';
import SiteHeader from '../ui/SiteHeader.astro';
import Tabs from '../ui/Tabs.astro';
import '../styles/experience.css';

/**
 * CAR SERVICE 06 — le document complet, dans l'ordre du récit : lisible sans script ni animation, indexable.
 * Mise en forme relevée sur les flyers de l'entreprise (tools/flyers) : noir, jaune pour le nettoyage, rouge pour la
 * location, badges à filet, pastilles d'icônes, tarifs dans un cadre néon. Avec script, chaque texte devient une
 * légende posée sur la scène (fenêtre de visibilité tirée de chapters.ts) et la vue épinglée porte la scène WebGL.
 */
const chapter = (id: string) => chapters.find((c) => c.id === id)!;
const win = (chapterId: string, panelId: string) => {
  const panel = chapter(chapterId).panels.find((p) => p.id === panelId)!;
  return `--in: ${panel.in}; --out: ${panel.out}`;
};
const euro = (amount: number) => `${amount} €`;
const service = (id: string) => cleaningServices.find((s) => s.id === id)!;
const vehicle = rentalFleet[0]!;
const offer = cleaningOffers[0]!;
const instagram = shown(property.channels.instagram);
const instagramUrl = instagram ? `https://www.instagram.com/${instagram}/` : null;
const rate = (days: number) => vehicle.rates.find((r) => r.days === days)!;

/** Prestations du flyer MAIN : pictogramme, titre, détails — dans l'ordre du flyer. */
const cleaningIcons = { interieur: 'seat', exterieur: 'car', finition: 'sparkle', produits: 'shield' } as const;
/** Conditions du flyer LOC, dans l'ordre du flyer. */
const rentalFeatures = [
  { icon: 'shield', fact: rentalTerms.insurance },
  { icon: 'gauge', fact: rentalTerms.mileage },
  { icon: 'fuel', fact: rentalTerms.economy },
  { icon: 'wheel', fact: rentalTerms.comfort },
  { icon: 'calendar', fact: rentalTerms.availability },
] as const;

const title = 'CAR SERVICE 06 — Nettoyage auto premium, déplacement dans tout le 06 · Location Toyota C-HR';
const description =
  'Nettoyage intérieur et extérieur, finition premium, produits professionnels : CAR SERVICE 06 se déplace dans tout le 06. Location d’un Toyota C-HR hybride dès 70 € par jour.';
---

<Base
  title={title}
  description={description}
  image={{
    src: '/media/stage/poster-desktop.webp',
    width: 1440,
    height: 900,
    alt: 'La Voie lactée au-dessus d’une mer de nuages, et le contour des Alpes-Maritimes éclairé dans la nuit.',
  }}
>
  <Fragment slot="head">
    <!--
      La première image du récit est la laque d'un véhicule 3D : son modèle et la nuit qui s'y reflète doivent
      descendre AVEC le document, pas après la création de la scène. Sans ces deux lignes, le rideau d'entrée reste
      levé trois secondes de plus pour rien.
    -->
    <link rel="preload" href="/models/rs6.glb" as="fetch" />
    <link rel="preload" href="/env/night-128.hdr" as="fetch" media="(max-width: 1099px)" />
    <link rel="preload" href="/env/night-256.hdr" as="fetch" media="(min-width: 1100px)" />
    <link rel="preload" href="/env/sky-2048.webp" as="image" type="image/webp" />
    <script is:inline>
      // Avant tout rendu : mise en page de l'expérience (.js) et entrée. On arrive TOUJOURS sur l'univers : ancre
      // retirée de l'adresse, position de défilement jamais restaurée. Si le module ne démarre pas (erreur, blocage),
      // le document redevient lisible au bout de 6 s.
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var q = new URLSearchParams(location.search);
        if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        if (!q.has('poster')) h.classList.add('has-intro', 'is-intro');
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        window.scrollTo(0, 0);
        // Garde-fou : si le module ne démarre pas du tout (erreur, blocage, réseau coupé), le document redevient
        // lisible. 12 s et non 6 : le premier plan du récit est un modèle 3D, et un téléphone lent met du temps à
        // préparer la scène — reprendre la main trop tôt casserait une expérience qui allait s'afficher.
        setTimeout(function () {
          if (!h.classList.contains('has-experience')) h.classList.remove('js', 'has-intro', 'is-intro');
        }, 12000);
      })();
    </script>
  </Fragment>

  <div class="intro" aria-hidden="true">
    <p class="intro__mark">CAR <span>SERVICE</span> 06</p>
    <p class="intro__line">{property.descriptors.cleaning.value} · Location</p>
    <span class="intro__bar"><span></span></span>
  </div>

  <SiteHeader />
  <Tabs />

  <main id="contenu">
    <ExperienceTrack label="CAR SERVICE 06 : nettoyage, puis location">
      <Fragment slot="stage">
        <picture class="stage__poster stage__poster--scene">
          <source media="(max-width: 1099px)" srcset="/media/stage/poster-mobile.avif" type="image/avif" />
          <source media="(max-width: 1099px)" srcset="/media/stage/poster-mobile.webp" type="image/webp" />
          <source srcset="/media/stage/poster-desktop.avif" type="image/avif" />
          <img src="/media/stage/poster-desktop.webp" width="1440" height="900" alt="" fetchpriority="high" decoding="async" />
        </picture>
        <canvas class="stage__canvas" data-stage-canvas></canvas>
        <div class="stage__veil"></div>
        <div class="gauge">
          <span class="gauge__label gauge__label--before">Avant</span>
          <span class="gauge__track"><span class="gauge__fill"></span><span class="gauge__dot"></span></span>
          <span class="gauge__label gauge__label--after">Après</span>
        </div>
        <div class="stage__progress"><span></span></div>
      </Fragment>

      <Chapter id="matiere" universe="cleaning" span={chapter('matiere').span} labelledby="titre-marque">
        <div class="panel panel--note" style={win('matiere', 'marque')}>
          <p class="kicker" id="titre-marque">{property.name.value} <span aria-hidden="true">·</span> {property.descriptors.cleaning.value}</p>
          <p class="note">{copy.matiere.note}</p>
          <p class="hint" aria-hidden="true"><span></span>{copy.scroll}</p>
        </div>
        <p class="sr-only">{copy.matiere.alt}</p>
      </Chapter>

      <Chapter id="revelation" universe="cleaning" span={chapter('revelation').span} labelledby="titre-promesse">
        <div class="panel panel--hero" style={win('revelation', 'promesse')}>
          <h1 id="titre-promesse" class="display">{property.taglines[0]!.value}</h1>
          <ul class="badges" aria-label="Ce que comprend la prestation">
            <li class="badge"><BrandIcon name="seat" />{offer.label.value}</li>
            <li class="badge"><BrandIcon name="van" />{property.coverage.value}</li>
          </ul>
          <p class="script">{copy.hero.script}</p>
        </div>
      </Chapter>

      <Chapter id="ciel" universe="bridge" span={chapter('ciel').span} labelledby="titre-ciel">
        <h2 id="titre-ciel" class="sr-only">{copy.ciel.title}</h2>
        <p class="sr-only">{copy.ciel.text}</p>
      </Chapter>

      <Chapter id="territoire" universe="territory" span={chapter('territoire').span} labelledby="titre-zone">
        <div class="panel panel--locator" style={win('territoire', 'france')}>
          <p class="locator"><span>France</span><i aria-hidden="true"></i><span>Alpes-Maritimes</span></p>
        </div>
        <div class="panel" style={win('territoire', 'deplacement')}>
          <p class="index"><span>{copy.zone.index}</span></p>
          <h2 id="titre-zone" class="title">{copy.zone.title}</h2>
          <p class="text"><strong>{property.coverage.value}.</strong> {offer.label.value}, chez vous.</p>
          <ul class="badges" aria-label="Zone d’intervention">
            <li class="badge"><BrandIcon name="pin" />Alpes-Maritimes <strong>06</strong></li>
          </ul>
          <p class="script">{property.servicePromise.value}</p>
        </div>
        <figure class="map" style={win('territoire', 'deplacement')}>
          <svg viewBox={map.viewBox} role="img" aria-label="Carte des Alpes-Maritimes (06)">
            {map.paths.map((d, k) => <path class={k === 0 ? 'map__land' : 'map__island'} d={d} pathLength="1" />)}
            <text class="map__num" x="560" y="520">06</text>
            <text class="map__sea" x="500" y="1215" text-anchor="middle">{copy.zone.sea}</text>
          </svg>
          <figcaption class="sr-only">Contour du département des Alpes-Maritimes (source : IGN Admin Express).</figcaption>
        </figure>
      </Chapter>

      <Chapter id="avant" universe="cleaning" span={chapter('avant').span} labelledby="titre-avant">
        <div class="panel" style={win('avant', 'avant')}>
          <p class="index"><span>{copy.avant.index}</span></p>
          <h2 id="titre-avant" class="title">{copy.avant.title}</h2>
          <p class="text">{copy.avant.text}</p>
          <p class="sr-only">{copy.scene}</p>
        </div>
      </Chapter>

      <Chapter id="intervention" universe="cleaning" span={chapter('intervention').span} labelledby="titre-passage">
        <div class="panel" style={win('intervention', 'lavage')}>
          <p class="index"><span>{copy.passage.index}</span></p>
          <h2 id="titre-passage" class="title">{copy.passage.title}</h2>
          <p class="text">
            <strong>{service('exterieur').title.value}</strong>
            {service('exterieur').details.value.join(' · ')}
          </p>
        </div>
        <div class="panel" style={win('intervention', 'meme')}>
          <p class="quote">{copy.passage.after}</p>
        </div>
      </Chapter>

      <Chapter id="transformation" universe="cleaning" span={chapter('transformation').span} labelledby="titre-apres">
        <div class="panel" style={win('transformation', 'apres')}>
          <p class="index"><span>{copy.apres.index}</span></p>
          <h2 id="titre-apres" class="title">{copy.apres.title}</h2>
          <p class="quote quote--tight">{copy.apres.reflets}</p>
          <p class="text">
            <strong>{service('finition').title.value}</strong>
            {service('finition').details.value.join(' · ')}
          </p>
        </div>
        <div class="panel" style={win('transformation', 'interieur')}>
          <p class="quote">{copy.apres.interieur}</p>
          <p class="text">
            <strong>{service('interieur').title.value}</strong>
            {service('interieur').details.value.join(' · ')}
          </p>
        </div>
      </Chapter>

      <Chapter id="prestations" universe="cleaning" span={chapter('prestations').span} labelledby="titre-prestations">
        <div class="panel panel--list" style={win('prestations', 'interieur-exterieur')}>
          <p class="index"><span>{copy.prestations.index}</span></p>
          <h2 id="titre-prestations" class="title">{copy.prestations.title}</h2>
          <ul class="features">
            {
              ['interieur', 'exterieur'].map((id) => (
                <li class="feature">
                  <span class="feature__icon" aria-hidden="true">
                    <BrandIcon name={cleaningIcons[id as keyof typeof cleaningIcons]} />
                  </span>
                  <div>
                    <h3 class="feature__title">{service(id).title.value}</h3>
                    <p class="feature__detail">{service(id).details.value.join(' · ')}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="panel panel--list" style={win('prestations', 'finition-produits')}>
          <ul class="features">
            {
              ['finition', 'produits'].map((id) => (
                <li class="feature">
                  <span class="feature__icon" aria-hidden="true">
                    <BrandIcon name={cleaningIcons[id as keyof typeof cleaningIcons]} />
                  </span>
                  <div>
                    <h3 class="feature__title">{service(id).title.value}</h3>
                    <p class="feature__detail">{service(id).details.value.join(' · ')}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="panel" style={win('prestations', 'offre')}>
          <h3 class="title title--small">{copy.prestations.offer}</h3>
          <ul class="badges" aria-label="Formule">
            <li class="badge"><BrandIcon name="car" />{offer.label.value}</li>
            <li class="badge badge--price" data-status={offer.price.status}>{euro(offer.price.value.amount)}</li>
            <li class="badge"><BrandIcon name="van" />{property.coverage.value}</li>
          </ul>
          <p class="script">{copy.prestations.script}</p>
        </div>
      </Chapter>

      <Chapter id="bascule" universe="bridge" span={chapter('bascule').span} labelledby="titre-bascule">
        <div class="panel" style={win('bascule', 'autre-route')}>
          <p class="index index--red"><span>{copy.bascule.index}</span></p>
          <h2 id="titre-bascule" class="title">{copy.bascule.title}</h2>
          <p class="text">{copy.bascule.text}</p>
        </div>
      </Chapter>

      <Chapter id="location" universe="rental" span={chapter('location').span} labelledby="titre-location">
        <div class="panel panel--rate" style={win('location', 'jour')}>
          <p class="index index--red"><span>{copy.location.index}</span></p>
          <h2 id="titre-location" class="title title--small">Location — {vehicle.model.value} {vehicle.energy.value.toLowerCase()}</h2>
          <p class="rate"><span class="rate__days">{rate(1).days} jour</span><span class="rate__price">{euro(rate(1).price.value.amount)}</span></p>
        </div>
        <div class="panel panel--rate" style={win('location', 'semaine')}>
          <p class="rate"><span class="rate__days">{rate(7).days} jours</span><span class="rate__price">{euro(rate(7).price.value.amount)}</span></p>
        </div>
        <div class="panel panel--rate" style={win('location', 'quinzaine')}>
          <p class="rate"><span class="rate__days">{rate(15).days} jours</span><span class="rate__price">{euro(rate(15).price.value.amount)}</span></p>
        </div>
        <div class="panel panel--list" style={win('location', 'conditions')}>
          <h3 class="title title--small">{copy.location.terms}</h3>
          <ul class="rates" aria-label="Tarifs de location">
            {
              vehicle.rates.map((r) => (
                <li class="rates__cell">
                  <span class="rates__price">
                    {r.price.value.amount}
                    <em>€</em>
                  </span>
                  <span class="rates__days">{r.label}</span>
                </li>
              ))
            }
          </ul>
          <ul class="features features--pair">
            {
              rentalFeatures.map((f) => (
                <li class="feature">
                  <span class="feature__icon" aria-hidden="true">
                    <BrandIcon name={f.icon} />
                  </span>
                  <div>
                    <h4 class="feature__title">{f.fact.value}</h4>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </Chapter>

      <Chapter id="rendezvous" universe="action" span={chapter('rendezvous').span} labelledby="titre-rendezvous">
        <div class="panel panel--form" style={win('rendezvous', 'agenda')}>
          <Rendezvous />
        </div>
      </Chapter>

      <Chapter id="contact" universe="action" span={chapter('contact').span} labelledby="titre-contact">
        <div class="panel panel--cta" style={win('contact', 'action')}>
          <p class="index"><span>{copy.contact.index}</span></p>
          <h2 id="titre-contact" class="title">{copy.contact.title}</h2>
          <p class="text">
            {offer.label.value} · {property.coverage.value}. Location {vehicle.model.value}, {rentalTerms.availability.value.toLowerCase()}.
          </p>
          {
            instagramUrl && (
              <a class="cta" href={instagramUrl} rel="noopener" target="_blank">
                {copy.contact.channel} <span>@{instagram}</span>
              </a>
            )
          }
          <p class="script">{copy.hero.script}</p>
        </div>
      </Chapter>
    </ExperienceTrack>
  </main>

  <footer class="site-footer">
    <p>© {property.name.value}</p>
    <p>Maquette de démonstration : informations commerciales à confirmer avant publication.</p>
    <p>
      Toyota et C-HR sont des marques de leurs propriétaires ; aucune affiliation. Modèles 3D des véhicules : fournis
      par l’entreprise. Cartes : IGN Admin Express. Ciel et matière de la chaussée : Poly Haven (CC0).
    </p>
  </footer>

  <MobileBar />
</Base>

<script>
  import { boot } from '../experience/boot';
  import { initRendezvous } from '../experience/rendezvous';
  boot();
  initRendezvous();
</script>
