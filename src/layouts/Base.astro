---
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Page hors index (404, laboratoire) : noindex, sans canonique. */
  noindex?: boolean;
  /** Image de partage (chemin public) et son alternative. */
  image?: { src: string; alt: string; width: number; height: number };
  /** Crochets de QA présents même dans le build (laboratoire du moteur). */
  qa?: boolean;
}

const { title, description, noindex = false, image, qa = false } = Astro.props;

// Indexation : le build de production est indexable (adresse : `site`, astro.config.mjs) ; le serveur de
// développement jamais. PUBLIC_INDEXABLE=false au build : préproduction non indexable.
const site = Astro.site;
const indexable = import.meta.env.PROD && Boolean(site) && import.meta.env.PUBLIC_INDEXABLE !== 'false' && !noindex;
const canonical = site && !noindex ? new URL(Astro.url.pathname, site).href : null;
const shareImage = site && image ? new URL(image.src, site).href : null;
// Données structurées limitées au site (nom vérifié) : aucune donnée d'entreprise tant qu'elle n'est pas confirmée.
const website =
  canonical && Astro.url.pathname === '/'
    ? { '@context': 'https://schema.org', '@type': 'WebSite', name: 'CAR SERVICE 06', url: canonical, inLanguage: 'fr-FR' }
    : null;
---

<!doctype html>
<html lang="fr" data-qa={qa ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#070708" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="CAR SERVICE 06" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      shareImage && image && (
        <>
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
          <meta name="twitter:image" content={shareImage} />
        </>
      )
    }
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {website && <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
