---
/**
 * Les deux métiers, comme sur les deux flyers : NETTOYAGE (jaune) et LOCATION (rouge). Ce sont de vrais liens vers les
 * chapitres — les pas guidés s'en chargent — et l'onglet actif suit l'univers du chapitre à l'écran
 * (`html[data-universe]`, écrit par le moteur).
 */
---

<nav class="tabs" aria-label="Les deux services">
  <a class="tab tab--cleaning" href="#arrivee">
    <span>Nettoyage</span>
  </a>
  <a class="tab tab--rental" href="#location">
    <span>Location</span>
  </a>
</nav>

<style>
  .tabs {
    position: fixed;
    top: var(--header-h);
    left: 50%;
    z-index: var(--z-header);
    display: flex;
    gap: 0.4rem;
    padding: 0.3rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(6px);
    transform: translate3d(-50%, 0, 0);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 7.4rem;
    min-height: 2.2rem;
    padding: 0 1rem;
    border-radius: 999px;
    color: var(--text-2);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color var(--duration-ui) linear,
      background-color var(--duration-ui) linear,
      box-shadow var(--duration-ui) linear;
    -webkit-tap-highlight-color: transparent;
  }

  /* Onglet actif : le plein de l'accent, comme les badges des flyers. */
  :global(html:not([data-universe='rental']):not([data-universe='bridge'])) .tab--cleaning,
  :global(html[data-universe='rental']) .tab--rental,
  :global(html[data-universe='bridge']) .tab--rental {
    background: var(--tab-fill);
    color: #000;
    box-shadow: 0 0 1.4rem var(--tab-glow);
  }

  .tab--cleaning {
    --tab-fill: var(--yellow);
    --tab-glow: rgb(253 199 39 / 0.35);
  }

  .tab--rental {
    --tab-fill: var(--red);
    --tab-glow: rgb(251 18 32 / 0.4);
  }

  .tab:hover {
    color: var(--text);
  }

  /* Sans script, la piste n'existe pas : les onglets restent des liens de navigation dans le flux. */
  :global(html:not(.js)) .tabs {
    position: static;
    margin: 1.2rem var(--gutter) 0;
    transform: none;
  }

  @media (max-width: 1099px) {
    .tabs {
      top: calc(var(--header-h) - 0.5rem);
    }

    .tab {
      min-width: 6.6rem;
      font-size: 0.82rem;
      letter-spacing: 0.14em;
    }
  }

  :global(.is-poster) .tabs,
  :global(.is-intro) .tabs {
    opacity: 0;
  }
</style>
