---
import { shown } from '../domain/facts';
import { property } from '../domain/property';

/**
 * En-tête : la marque (« 06 » à l'accent de l'univers), les chapitres (saut direct au clavier comme au doigt) et le
 * seul canal confirmé. Sur téléphone : marque et Instagram ; l'action vit dans la barre du bas (MobileBar).
 */
const instagram = shown(property.channels.instagram);
// ANCRES VÉRIFIÉES CONTRE LES CHAPITRES RÉELS. « #avant » et « #zone » désignaient des chapitres supprimés depuis
// des semaines : les deux liens ne faisaient rien, et un lien qui ne fait rien est pire qu'un lien absent — on
// croit que le site est cassé. Les identifiants existants sont ceux de src/experience/chapters.ts : galaxie,
// descente, ville, arrivee, intervention, transformation, prestations, tarifs, bascule, location, rendezvous,
// contact.
const nav = [
  { href: '#arrivee', label: 'Nettoyage' },
  { href: '#tarifs', label: 'Tarifs' },
  { href: '#location', label: 'Location' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <a class="site-header__brand" href="#galaxie" aria-label={`${property.name.value} — haut de page`}>
    CAR SERVICE <span class="site-header__num">06</span>
  </a>
  <nav class="site-header__nav" aria-label="Chapitres">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  {
    instagram && (
      <a class="site-header__social" href={`https://www.instagram.com/${instagram}/`} rel="noopener" target="_blank" aria-label={`Instagram @${instagram}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6" />
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" />
          <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
        </svg>
      </a>
    )
  }
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
    padding: 0 var(--gutter);
    background: linear-gradient(180deg, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__num {
    color: var(--gold);
  }

  .site-header__nav {
    margin-left: auto;
  }

  .site-header__nav ul {
    display: flex;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a,
  .site-header__social {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--duration-ui) linear;
  }

  .site-header__nav a:hover,
  .site-header__social:hover {
    color: var(--text);
  }

  .site-header__social {
    justify-content: center;
    min-width: 44px;
  }

  @media (max-width: 1099px) {
    .site-header__nav {
      display: none;
    }

    .site-header__social {
      margin-left: auto;
    }
  }
</style>
